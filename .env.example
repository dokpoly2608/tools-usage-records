# 命令用法知识库 —— 端口与环境配置
# 复制为 .env 后按需修改（.env 不入库，.env.example 入库作模板）。

# 后端服务端口
BACKEND_PORT=3000

# 前端 dev 服务端口
FRONTEND_PORT=5173

# 后端主机（vite proxy 目标，本机开发一般不用改）
BACKEND_HOST=localhost

# 导入脚本用（scripts/import.mjs / import-categories.mjs）
API_BASE=http://localhost:3000/api

# 数据库（远程 MySQL 5.7）。本地开发写入 .env；部署时用同名环境变量覆盖即可。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tools_kb
DB_PASSWORD=change-me
DB_NAME=tools_kb
